# .gitignore — forecast-service
# Tujuan: mencegah kebocoran kunci, data mentah, dan artefak yang bisa diregenerasi.

# --- Kredensial & lingkungan (JANGAN PERNAH COMMIT) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
secrets.json

# --- Artefak Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/
venv/
env/

# --- Data mentah (ada di luar folder service; jangan digandakan) ---
data/raw/
*.nc
Data-*/

# --- Artefak model yang bisa diregenerasi (python scripts/export_model.py) ---
# model.pkl = snapshot hasil fit ARIMA (±2,6 MB) — runtime TIDAK memuatnya.
# Regenerasi: python scripts/export_model.py
model/model.pkl

# --- File editor / OS ---
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
