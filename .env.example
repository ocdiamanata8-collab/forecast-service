# Template konfigurasi environment untuk forecast-service.
# SALIN ke `.env` (yang .gitignore-nya mengabaikan file ini) lalu isi nilainya.
# JANGAN PERNAH menaruh kunci nyata di berkas ini — `.env` sudah di-gitignore,
# `.env.example` BISA ter-commit.

# Daftar API key dipisah koma. Wajib untuk semua endpoint kecuali /api/v1/health.
# Tanpa ini, endpoint ber-key membalas 401 E_UNAUTHORIZED (by design — tidak ada
# fallback key di kode).
#   Contoh lokal: API_KEYS=dev-local-12345678901234567890
API_KEYS=

# Daftar site yang dikenal layanan (404 E_SITE_UNKNOWN untuk yang tidak terdaftar).
# Default: PLTS_KUPANG
SITE_IDS=PLTS_KUPANG

# Host/port uvicorn (opsional; hanya untuk menjalankan lokal).
HOST=127.0.0.1
PORT=8000
