# Template konfigurasi environment untuk forecast-service.
# SALIN ke `.env` (yang .gitignore-nya mengabaikan file ini) lalu isi nilainya.
# JANGAN PERNAH menaruh kunci nyata di berkas ini — `.env` sudah di-gitignore,
# `.env.example` BISA ter-commit. Kunci produksi dibuat di HOST/platform
# hosting, bukan ditulis di repository, di URL, atau di file HTML.

# Daftar API key dipisah koma. Wajib untuk semua endpoint kecuali /api/v1/health.
# Tanpa ini, endpoint ber-key membalas 401 E_UNAUTHORIZED (by design — tidak ada
# fallback key di kode).
#
# Minimum 16 karakter per kunci (lihat app/security.py) — contoh pendek seperti
# `abc123xyz` akan DITOLAK saat startup, bukan diam-diam diterima.
#
# Format: dua kunci atau lebih dipisah koma, tanpa spasi (spasi ikut terbaca
# sebagai bagian kunci dan membuat request 403). Generate kunci lokal:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Contoh: API_KEYS=<token_urlsafe_43huruf>,<token_urlsafe_lagi>
API_KEYS=

# Daftar site yang dikenal layanan (404 E_SITE_UNKNOWN untuk yang tidak terdaftar).
# Default: PLTS_KUPANG
SITE_IDS=PLTS_KUPANG

# ---------------------------------------------------------------------------
# Scheduler rolling forecast (Fase 4 — kontrak §5.1/§8)
# ---------------------------------------------------------------------------
# Job latar belakang yang mengisi GET /forecast/latest dan /forecast/history
# dengan memanggil rantai IDENTIK endpoint POST (service.run_forecast), dari
# tail data/actuals.csv. Tick pertama berjalan saat startup (latest langsung
# terisi), lalu regenerasi per jam (SLA §5.2: 90 menit).
#
# Matikan hanya untuk: (a) test, (b) proses worker sekunder bila service
# di-scale > 1 proses — ARIMA fit di tiap worker adalah pemborosan CPU.
# SCHEDULER_ENABLED=true
#
# Interval regenerasi dalam detik (default 3600 = per jam, minimum 1).
# SCHEDULER_INTERVAL_SECONDS=3600

# Host/port uvicorn (opsional; hanya untuk menjalankan lokal).
HOST=127.0.0.1
PORT=8000


# ---------------------------------------------------------------------------
# Mengapa TIDAK ada MODEL_VERSION dan TZ di sini
# ---------------------------------------------------------------------------
# Kedua nama itu sah sebagai env var di hosting lain, tapi untuk service ini
# menaruhnya justru menciptakan sumber kebenaran ganda — dan sumber kebenaran
# ganda adalah akar masalah yang sudah kita perangi sejak awal.
#
# MODEL_VERSION:
#   Versi model hidup di `model/VERSION` (baris pertama) — SATU-SATUNYA sumber.
#   Dibaca `app/version.py` dan diuji oleh `tests/test_version.py`, yang akan
#   GAGAL bila ada literal versi kedua di mana pun. Menambah `MODEL_VERSION`
#   ke env tidak mengubah apa pun (tidak ada kode yang membacanya) kecuali
#   developer mengira versinya sudah berganti. Ganti versi dengan mengedit
#   `model/VERSION`, lalu jalankan `python scripts/export_model.py` bila
#   artefak ikut berubah.
#
# TZ:
#   Zona site DIKUNCI ke `Asia/Makassar` (WITA, UTC+8) — sesuai lokasi PLTS
#   Kupang. `Asia/Jakarta` (UTC+7) akan menggeser seluruh timestamp 1 jam dan
#   membuat filter siang 07:00–17:00 pada data salah — persis kekeliruan zona
#   yang sudah diperangi (KONTRAK_API_v1.md §1.5). Kode memakai `ZoneInfo`
#   eksplisit, jadi env `TZ` tidak berpengaruh ke timestamp yang dihasilkan —
#   menuliskannya hanya membingungkan. Zona hanya boleh berubah dengan
#   mengubah konstanta di `app/preprocessing.py` + kontrak, yang berarti
#   perubahan kontrak (breaking), bukan pengaturan deployment.
